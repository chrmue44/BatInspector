<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>kopf64.ico</ApplicationIcon>
    <StartupObject />
    <Win32Resource />
    <Authors>Christian Müller</Authors>
  </PropertyGroup>
  
  <PropertyGroup> 
     <TargetFramework>net10.0-windows</TargetFramework> 
     <UseWPF>true</UseWPF> 
     <UseWindowsForms>true</UseWindowsForms> 
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="images\pause.png" />
  </ItemGroup>
  
  
  <ItemGroup>
    <PackageReference Include="BunLabs.NAudio.Flac" Version="2.0.1" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\libBioAcoustics\libBioAcoustics.vcxproj" />
    <ProjectReference Include="..\libScripter\libScripter.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="NAudio">
      <HintPath>..\packages\NAudio.2.2.1\lib\net6.0\NAudio.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <!-- Use Content + copy for images so they can be loaded with relative URIs at runtime -->
    <Content Include="images\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
