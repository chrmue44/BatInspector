<UserControl x:Class="BatInspector.Controls.CtlCallItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BatInspector.Controls"
             xmlns:res="clr-namespace:BatInspector.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="22" d:DesignWidth="800">
    <DockPanel>
        <TextBlock Name="_lbl"  TextAlignment="Right" Margin="0,1,5,0" Height="20" Width="80" Background="{DynamicResource colorBackGround}" Foreground="{DynamicResource colorForeGroundLabel}" MouseDown="_lbl_MouseDown" ToolTip="{x:Static res:MyResources.ctlWavToolTipCall}" >lbl1</TextBlock>
        <TextBox Name= "_tb"  VerticalAlignment="Top" Margin="0,1,5,0" VerticalContentAlignment="Center" BorderThickness="1"  Height="20" Background="{DynamicResource colorBackGroundTextB}" Foreground="{DynamicResource colorForeGroundLabel}" TextChanged="_tb_TextChanged" PreviewMouseDown="_tb_MouseDown" ContextMenuOpening="_tb_ContextMenuOpening" ToolTip="{x:Static res:MyResources.ctlWavToolTipEdit}"></TextBox>
    </DockPanel> 
</UserControl>
