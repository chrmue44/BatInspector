<UserControl x:Class="BatInspector.Controls.ctlComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BatInspector.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal" Height="32">
        
        <Label Name="_lbl" Width="250" HorizontalContentAlignment="Right">Component</Label>
        <Image Name="_imgOk"  Source="/images/check.png" Width="32" Height="32" Margin="20,0,30,0"/>
        <Image Name="_imgNok" Source="/images/danger-sign.png" Width="32" Height="32" Margin="20,0,30,0"/>
    </StackPanel>
</UserControl>
