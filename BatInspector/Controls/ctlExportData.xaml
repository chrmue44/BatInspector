<UserControl x:Class="BatInspector.Controls.ctlExportData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BatInspector.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="127" d:DesignWidth="850">
    <GroupBox>
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="22"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>
            <local:ctlDataItem Grid.Row="0" Grid.Column="0" x:Name="_ctlLocal" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="1" Grid.Column="0" x:Name="_ctlLatin" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="0" Grid.Column="1" x:Name="_ctlLat" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="1" Grid.Column="1" x:Name="_ctlLon" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="0" Grid.Column="2" x:Name="_ctlTemp" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="1" Grid.Column="2" x:Name="_ctlHumid" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="0" Grid.Column="3" x:Name="_ctlDate" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="_ctlPathWav" Margin="0,0,0,0"/>
            <local:ctlDataItem Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" x:Name="_ctlPathPng" Margin="0,1,0,0"/>
            <local:ctlDataItem Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="_ctlComment" Margin="0,1,0,0"/>
        </Grid>
    </GroupBox>
</UserControl>
