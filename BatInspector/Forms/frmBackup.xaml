<Window x:Class="BatInspector.Forms.frmBackup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatInspector.Controls"
        xmlns:res="clr-namespace:BatInspector.Properties"
        mc:Ignorable="d"
        Title="{x:Static res:MyResources.frmBackupTitle}" Height="250" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <local:CtlSelectFile x:Name="_ctlSrcDir"></local:CtlSelectFile>
            <local:CtlSelectFile x:Name="_ctlDstDir"></local:CtlSelectFile>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,50,20,0">
                <Button Name="_btnCancel" Content="Cancel" Width="120" Height="25" Margin="0,0,10,0" Click="_btnCancel_Click"></Button>
                <Button Name="_btnOk" Content="OK" Width="120" Click="_btnOk_Click"></Button>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
